# ── Copy this to .env and fill in values — NEVER commit .env ────────────────

# MongoDB
MONGODB_URI=mongodb+srv://sewingcircleservice_db_user:0BpS9OYH6HSBeALr@typicalcluster.z8ahqvz.mongodb.net/sewingcircle?retryWrites=true&w=majority

# JWT session token
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_EXPIRES_IN=8h

# MFA bridge token (step 1 → step 2, 10 min)
MFA_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
MFA_TOKEN_EXPIRES_IN=10m

# TOTP secret encryption key — AES-256-GCM, 32 bytes = 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPT_KEY=REPLACE_WITH_64_CHAR_HEX

# Server
PORT=4000

# Frontend origin for CORS (also accepts FRONTEND_URL for Render legacy compat)
FRONTEND_ORIGIN=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend email API — https://resend.com (free: 3,000 emails/month)
# Get API key from the Resend dashboard → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address
# Without custom domain use: onboarding@resend.dev (delivers to your verified Resend email only)
# With custom domain (add DNS records in Resend dashboard): noreply@sewingcircle.io
EMAIL_FROM=onboarding@resend.dev
