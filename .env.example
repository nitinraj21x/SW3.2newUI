# Frontend environment — copy to .env.local and fill in values
# VITE_ prefix required for Vite to expose to the browser

# API base URL — only needed in production (Render URL)
# In dev, the Vite proxy handles /api → localhost:4000
VITE_API_URL=https://your-backend.onrender.com/api

# Dev: override the proxy target if backend runs on a different port
VITE_API_TARGET=http://localhost:4000
